# Line endings: store and check out text files with LF (standard for a static site on Vercel).
# This overrides core.autocrlf=true on Windows, so git stops warning "LF will be replaced by CRLF".
* text=auto eol=lf

# Shell hooks must stay LF even on Windows checkouts.
.githooks/* text eol=lf

# Windows-only scripts keep CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files: never convert.
*.pdf binary
*.docx binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
